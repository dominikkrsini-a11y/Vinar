## Copy to `.env` for local development (do not commit `.env`).
#
# ─── SERVER-ONLY secrets (server/index.js) ─────────────────────────────────
# These must NEVER be prefixed with EXPO_PUBLIC_. Any EXPO_PUBLIC_* variable
# is bundled into the client app binary and becomes readable by anyone who
# installs the app. ANTHROPIC_API_KEY must only ever live on the server.
ANTHROPIC_API_KEY=
#
# ─── CLIENT-SAFE config (Expo app) ─────────────────────────────────────────
# Safe to expose — not secrets, just endpoint/project identifiers. Every
# environment (development / preview / production) must set its own values
# for these via EAS Environment Variables. See eas.json + Railway deploy
# notes for how each environment is configured.

# Firebase client config (from Firebase Console → Project Settings).
# Identical across environments today because this project uses a single
# Firebase project (vinar-app) for all environments.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Base URL of the assistant proxy (server/). This MUST differ per
# environment — never hardcode a production URL here or in app.config.js:
#   development → http://localhost:3001 (or your LAN IP for a physical device)
#   preview     → your Railway staging/preview URL, if any
#   production  → your Railway production URL (https://...)
EXPO_PUBLIC_ASSISTANT_BASE_URL=http://localhost:3001

# ─── Crash/error reporting (Sentry) — optional ─────────────────────────────
# Client-safe DSN (public key + project id, not a secret). Leave unset to
# run with Sentry fully disabled (App.js only calls Sentry.init if this is
# set, and only outside __DEV__).
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (never EXPO_PUBLIC_) — used solely by the Sentry Expo
# config plugin during `expo prebuild` / EAS Build to upload source maps.
# SENTRY_ORG/SENTRY_PROJECT are non-secret identifiers; SENTRY_AUTH_TOKEN is
# a real secret and must be set as an EAS *Secret* (or local-only env var),
# never committed and never given the EXPO_PUBLIC_ prefix.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
