{
  "expo": {
    "name": "Vinar",
    "slug": "vinar",
    "scheme": "vinar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0608"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danilo1.vinar"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0608"
      },
      "package": "com.danilo1.vinar",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2d68e9fa-4032-4bc2-9188-5fad1b9f8af3"
      }
    },
    "owner": "danilo1"
  }
}
