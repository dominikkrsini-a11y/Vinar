{
  "expo": {
    "name": "Vinar",
    "slug": "vinar",
    "scheme": "vinar",
    "version": "1.0.0",
    "description": "Cellar logbook, winemaking calculators, and an AI assistant for small wine producers. Track fermentation, SO2, racking, and measurements — even offline in the cellar.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0608"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danilo1.vinar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Vinar uses the camera to photograph wines, cellar notes, and marketplace listings.",
        "NSPhotoLibraryUsageDescription": "Vinar uses your photo library for a profile picture and marketplace listing photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0608"
      },
      "package": "com.danilo1.vinar",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2d68e9fa-4032-4bc2-9188-5fad1b9f8af3"
      }
    },
    "owner": "danilo1"
  }
}
