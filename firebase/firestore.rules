rules_version = '2';

// Vinar — Firestore security rules
//
// Data model (see src/firebase/firestore.js + src/firebase/feedback.js):
//   users/{userId}                        — profile fields (owner-only)
//   users/{userId}/wines/{wineId}          — wine records (owner-only)
//   users/{userId}/wines/{wineId}/entries/{entryId} — logbook entries (owner-only)
//   listings/{listingId}                   — marketplace listings (global collection,
//                                             authenticated read, owner-only write)
//   feedback/{feedbackId}                  — beta micro-survey answers (owner create/read)
//
// Principle: client-side ownership checks (e.g. `listing.userId !== auth.currentUser.uid`
// in MarketplaceScreen.js) are NOT security — these rules are the actual enforcement.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── User profile ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ── Wines (subcollection) ───────────────────────────────────────
      match /wines/{wineId} {
        allow read, write: if isOwner(userId);

        // ── Logbook entries (sub-subcollection) ─────────────────────
        match /entries/{entryId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ── Marketplace listings (global collection) ────────────────────────
    match /listings/{listingId} {
      // Any signed-in user can browse listings.
      allow read: if isSignedIn();

      // Only signed-in users can post, and only as themselves.
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      // Only the original poster can edit or delete their listing.
      allow update, delete: if isSignedIn()
                             && resource.data.userId == request.auth.uid;
    }

    // ── Beta micro-survey feedback (global collection) ──────────────────
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Usage analytics events (global collection) ─────────────────────
    match /analytics_events/{eventId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                  && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Assistant daily usage counters (global collection) ─────────────
    match /assistantUsage/{userId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      match /daily/{dailyId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
