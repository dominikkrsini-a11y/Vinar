## Copy to server/.env for local development (do not commit server/.env).
## ANTHROPIC_API_KEY and the three FIREBASE_* vars are required — server/config.js
## will refuse to start if any are missing. UPSTASH_* vars are optional locally
## (rate limiting is skipped with a startup warning). On Railway/production,
## set both UPSTASH_* vars so per-user rate limiting stays active.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Firebase Admin service account (Firebase Console → Project Settings →
# Service Accounts → Generate new private key). Use the values from the
# downloaded JSON file's "project_id", "client_email", and "private_key".
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the literal "\n" sequences from the JSON file's private_key field —
# config.js converts them back into real newlines at boot.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Upstash Redis (per-user rate limiting). Optional for local dev — leave empty
# to skip rate limiting. Required on Railway/production. Create a free database
# at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Railway sets this automatically. Defaults to 3001 locally.
PORT=3001

# Optional — server-side Sentry Node SDK (see index.js). Every request
# error is already logged as structured JSON to stdout/stderr regardless
# (visible in Railway's log viewer); setting this additionally forwards
# exceptions to Sentry. This is a different DSN from the client's
# EXPO_PUBLIC_SENTRY_DSN — use a separate server-side Sentry project.
SENTRY_DSN=
